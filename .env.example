# Konfiguracja Docker Compose. Skopiuj do .env w katalogu repozytorium.
MINIX_PORT=8080
POSTGRES_DB=minix
POSTGRES_USER=minix
POSTGRES_PASSWORD=

# Wstaw losowy sekret o długości co najmniej 32 bajtów.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

AI_MODERATION_ENABLED=false
AI_BASE_URL=http://host.docker.internal:1234
AI_MODEL=basal-omni-1.0-mini