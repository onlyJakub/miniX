DATABASE_URL=postgresql://minix:CHANGE_ME@127.0.0.1:5432/minix

# Wygeneruj sekret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_EXPIRE_MINUTES=60

# false dla HTTP, true dla HTTPS.
COOKIE_SECURE=false
AUTH_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8000